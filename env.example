# Copy to .env and fill in. .env is git-ignored — never commit it.
# Values here are the defaults; anything you leave unset falls back to them.
# Real environment variables take precedence over this file.

# --- Main app ---------------------------------------------------------------
# Required for every /api request (X-API-Key header, ?key= query param, or the
# audiolog_key cookie). Generate one with: openssl rand -hex 16
# NOTE: this only seeds the admin account on first run, when the database is
# still empty. Changing it later does not update the existing user row.
AUDIOLOG_API_KEY=

# --- Transcription (whisper_service) ----------------------------------------
# Runs separately because mlx-whisper is Apple Silicon-only. Point at a Tailscale
# hostname to run it on another Mac; see start_whisper.sh.
WHISPER_URL=http://localhost:8301
# If set, sent as X-API-Key to the whisper service. Empty = no auth.
WHISPER_API_KEY=
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# --- Chat + embeddings (Ollama-compatible API) ------------------------------
# Summaries, titles, tags, translation and the assistant all go through this.
LLM_API_URL=http://localhost:11434
# If set, sent as `Authorization: Bearer ...`. Empty = no auth (plain Ollama).
LLM_API_KEY=
LLM_MODEL=qwen3.6:27b
EMBED_MODEL=nomic-embed-text

# --- Storage ----------------------------------------------------------------
# Paths under AUDIOLOG_DATA_DIR are stored in the database relative to it, so the
# database stays portable. Pointing the dirs below outside it (e.g. at a Google
# Drive-synced folder) means those rows store absolute, machine-specific paths.
# AUDIOLOG_DATA_DIR=./data
# AUDIOLOG_INPUT_DIR=./data/input
# AUDIOLOG_OUTPUT_DIR=./data/output
# AUDIOLOG_DB=./data/audiolog.db
# Extra watched folders, comma-separated.
# AUDIOLOG_EXTRA_INPUT_DIRS=
# If set, each finished job's outputs are mirrored here.
# AUDIOLOG_PUBLISH_DIR=

# How often (seconds) the ingest loop scans the input dirs for new files.
# AUDIOLOG_SCAN_INTERVAL=3
